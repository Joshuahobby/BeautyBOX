# Staging settings (DR-044). Copy to .env.staging.local (never committed or uploaded) and fill
# in the lines marked FOUNDER. The scripts fill in the lines marked GENERATED and never print them.
# Push to Vercel with: npm run staging:env-push -- --env-file .env.staging.local --target production

APP_ENV=staging
APP_ORIGIN=https://staging.beautyboxmarket.com

# Database (Supabase project "BeautyBOX Web App", eu-west-1)
# FOUNDER: Supabase > Connect > Session pooler, user postgres.<project-ref>, port 5432, with the
# database password. Used only by scripts/ops/staging-bootstrap.ts on this machine; never sent to Vercel.
STAGING_OWNER_DATABASE_URL=
# GENERATED by staging-bootstrap.ts: runtime role through the transaction pooler (port 6543)
DATABASE_URL=
STAGING_RUNTIME_DB_PASSWORD=
DATABASE_POOL_MAX=3
# FOUNDER: Supabase > Database > Settings > SSL Configuration > download the certificate, then
# paste it here on ONE line with \n between lines. Without it, use DATABASE_SSL=require.
DATABASE_SSL=verify
DATABASE_SSL_CA=

# GENERATED by staging-bootstrap.ts (staging-only values; never reuse them anywhere else)
DATA_ENCRYPTION_KEY=
TOKEN_HASH_SECRET=
WORKER_SECRET=

# Payments: pawaPay SANDBOX only (copy the sandbox token and signing key from .env.local)
PAYMENT_PROVIDER=pawapay
PAWAPAY_MODE=sandbox
PAWAPAY_API_TOKEN=
PAWAPAY_SIGNING_PRIVATE_KEY=
PAWAPAY_SIGNING_KEY_ID=

# Not built yet: simulated routing
ROUTING_PROVIDER=fake
DEMO_CATALOG_VISIBLE=true

# SMS: disabled, or the Africa's Talking SANDBOX only (messages reach only their simulator; a live
# account is refused outside production). To use the sandbox: SMS_PROVIDER=africastalking,
# AFRICASTALKING_USERNAME=sandbox and the sandbox API key (copy from .env.local). For delivery
# reports, run npx tsx scripts/ops/sms-callback-token.ts --env-file .env.staging.local and enter the
# address it prints in the sandbox dashboard (SMS > SMS Callback URLs > Delivery Reports).
SMS_PROVIDER=disabled
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_CALLBACK_TOKEN=

# Staff sign-in and photos (same Supabase project; copy from .env.local)
STAFF_AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
MEDIA_STORAGE=supabase

# Pre-launch wall: set the code with npm run staging:access-code -- --env-file .env.staging.local
SITE_GATE=on
SITE_ACCESS_CODE_HASH=
HOLDING_HOSTS=beautyboxmarket.com,www.beautyboxmarket.com

# Launch list: stays closed until the founder opens it (see docs/DEPLOYMENT.md)
LAUNCH_LIST=closed
LAUNCH_LIST_CONTACT_EMAIL=
