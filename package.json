{
  "name": "beautybox-app",
  "version": "0.1.0",
  "private": true,
  "description": "BeautyBOX Phase 1 storefront, checkout and staff operations (modular Next.js monolith).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:local": "node scripts/db/local-postgres.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed:demo": "tsx --conditions=react-server --env-file=.env.local scripts/seed-demo.ts",
    "worker": "tsx --conditions=react-server --env-file=.env.local scripts/worker.ts",
    "design:tokens": "node scripts/design/generate-tokens.mjs",
    "design:tokens:check": "node scripts/design/generate-tokens.mjs --check",
    "design:font": "node scripts/design/build-font.mjs",
    "contract:check": "node scripts/contract/build-contract.mjs --check",
    "verify": "npm run design:tokens:check && npm run contract:check && npm run typecheck && npm run lint && npm run test:unit",
    "setup:local": "node scripts/setup-local.mjs",
    "staff:grant": "tsx --conditions=react-server --env-file=.env.local scripts/staff/grant.ts",
    "staff:set-password": "tsx --conditions=react-server --env-file=.env.local scripts/staff/set-password.ts",
    "ops:checkout": "tsx --conditions=react-server scripts/ops/checkout-switch.ts",
    "ops:drill": "node scripts/ops/backup-restore-drill.mjs",
    "contract:build": "node scripts/contract/build-contract.mjs",
    "ops:sweep": "tsx --conditions=react-server scripts/ops/reconciliation-sweep.ts",
    "staging:bootstrap": "tsx --conditions=react-server scripts/ops/staging-bootstrap.ts",
    "staging:staff-grant": "tsx --conditions=react-server --env-file=.env.staging.local scripts/staff/grant.ts",
    "staging:access-code": "tsx --conditions=react-server scripts/ops/site-access-code.ts",
    "staging:env-push": "tsx scripts/ops/vercel-env-push.ts",
    "launch-list": "tsx --conditions=react-server --env-file=.env.staging.local scripts/ops/launch-list.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "get-nonce": "1.0.1",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.55.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "subset-font": "2.9.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "$vite"
  }
}
