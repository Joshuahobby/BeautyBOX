# Variable names only. Real values live in the host's secret manager (staging/production)
# or in .env.local / .env.test generated by `npm run setup:local` (local only). Never put
# secrets in NEXT_PUBLIC_* variables, Git, screenshots or documents.

# local | test | staging | production
APP_ENV=
# Public origin of this deployment, e.g. https://shop.example.rw (https required in production)
APP_ORIGIN=
# Runtime connection (narrow role, pooled where applicable)
DATABASE_URL=
# Migration connection (schema owner, direct/session connection) - used by prisma.config.ts only
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=
# TLS to the database: off (this machine only) | require | verify (needs DATABASE_SSL_CA, one-line PEM)
DATABASE_SSL=
DATABASE_SSL_CA=
# 32 random bytes, base64 (AES-256-GCM for payer phone and callback evidence)
DATA_ENCRYPTION_KEY=
# >= 32 chars; keys the hashes of guest-session and private-link tokens
TOKEN_HASH_SECRET=
# >= 32 chars; bearer secret for POST /api/v1/internal/jobs/run (scheduler)
WORKER_SECRET=
# fake | pawapay   (fake is rejected in production)
PAYMENT_PROVIDER=
# fake | google    (fake is rejected in production)
ROUTING_PROVIDER=
# disabled | fake | africastalking   (fake is rejected in staging and production)
SMS_PROVIDER=
# true only in local/test; rejected in production
DEMO_CATALOG_VISIBLE=
# pawaPay (I07, DR-042). sandbox | production; production is refused unless APP_ENV=production.
# Never put production credentials in a development file.
PAWAPAY_MODE=
PAWAPAY_API_TOKEN=
# Request signing (set both or neither); one-line PEM with \n is accepted
PAWAPAY_SIGNING_PRIVATE_KEY=
PAWAPAY_SIGNING_KEY_ID=
# Only for a local imitation of pawaPay in development and tests
PAWAPAY_BASE_URL=
# Africa's Talking SMS (I11, DR-048), server-only. Username "sandbox" uses Africa's Talking's
# sandbox (messages reach only their simulator); any other username is a live account, which is
# refused unless APP_ENV=production. The API key comes from the dashboard of that same account.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Approved sender ID or short code; optional until approved, required in production
AFRICASTALKING_SENDER_ID=
# Secret part of the delivery-report address; make one with
# npx tsx scripts/ops/sms-callback-token.ts --env-file <file>. Unset: delivery reports refused (404).
AFRICASTALKING_CALLBACK_TOKEN=
# Google Routes (I12, gate G1)
GOOGLE_ROUTES_API_KEY=
# Supabase staff auth/storage (I08)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Staff identity: disabled | supabase | test (test only with APP_ENV=test)
STAFF_AUTH_PROVIDER=
# Product photos / private evidence: local (development only) | supabase (DR-041).
# supabase needs NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY (server-only).
MEDIA_STORAGE=local
# Bucket names (defaults shown): private uploads and derivatives, public approved photos
SUPABASE_PRIVATE_MEDIA_BUCKET=private-media
SUPABASE_PUBLIC_MEDIA_BUCKET=product-photos
# Optional public base URL for product photos, e.g. a CDN domain (defaults to the public
# bucket with MEDIA_STORAGE=supabase, else APP_ORIGIN/media)
NEXT_PUBLIC_MEDIA_BASE_URL=
# Pre-launch wall (DR-044): off | on. With on, visitors need the access code; set it with
# npm run staging:access-code (only the scrypt verifier is stored, never the code)
SITE_GATE=
SITE_ACCESS_CODE_HASH=
# Hosts that only show "Launching soon", comma-separated (e.g. the main domain before launch)
HOLDING_HOSTS=
# Launch list (DR-045): closed | open; open needs the privacy contact address
LAUNCH_LIST=
LAUNCH_LIST_CONTACT_EMAIL=
